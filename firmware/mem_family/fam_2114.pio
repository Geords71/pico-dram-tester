; 2114 Test Program

; Note: 'set PINDIRS' also sets all high order bits to 0, so we can't use it!

; Pin Assignments
; SP0  = IO4
; SP1  = IO3
; SP2  = A1
; SP3  = CS
; SP4  = WE
; SP5  = A0
; SP6  = A3
; SP7  = A4
; SP8  = A5
; SP9  = A7
; SP10 = A8
; SP11 = A9
; SP12 = A6
; SP13 = nc
; SP14 = IO1
; SP15 = A2
; SP16 = IO2

; PIO version 1 since we need to mov pindirs
.pio_version 1

.program fam_2114

.define CMD_ALL_OFF 0b11
.define CMD_CS_ON 0b10
.define CMD_ALL_ON 0b00

pull block                 ; Wait for data pin dir mask.
out y, 17                  ; Read the data pin dir mask into y.

; make is a bit easier to reason timings if we start begin at point where
; the address is reset. So jump to actual start of loop!
jmp enter                  

begin:
    out pins, 17           ; Load address, data, and CMD_ALL_OFF. Start of tRC, tWC, tDW.
    jmp !x read_branch     ; Skip write if not in write mode

write_branch:
    mov pindirs, ~NULL     ; All outputs.
    set pins, CMD_ALL_ON   ; Lower CS and WE. Start of tW.
    jmp rejoin

read_branch:
    mov pindirs, ~y        ; Set data pins as input (0).
    set pins, CMD_CS_ON    ; Lower CS only. Start of tCO.
    jmp rejoin

rejoin:
    nop [1]                ; 
    nop [2]                ; 
    in y, 17            ; Copy all pins to the ISR. tCO must be met.
    push noblock           ; Push the ISR.
    nop [3]
    set pins, CMD_ALL_OFF  ; Raise CS and WE. tDW, tW must be met.

enter:
    pull block          ; Get the next command.
    out x, 1            ; Get first bit which tells us if we are in write mode.
    nop [4]
    nop [5]
    nop [6]
    jmp begin           ; tRC, tWC, tOTD must be met.