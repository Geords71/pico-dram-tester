; 2114 Test Program

; Note: 'set PINDIRS' also sets all high order bits to 0, so we can't use it!

; Pin Assignments
; SP0  = IO4
; SP1  = IO3
; SP2  = A1
; SP3  = CS
; SP4  = WE
; SP5  = A0
; SP6  = A3
; SP7  = A4
; SP8  = A5
; SP9  = A7
; SP10 = A8
; SP11 = A9
; SP12 = A6
; SP13 = nc
; SP14 = IO1
; SP15 = A2
; SP16 = IO2

; PIO version 1 since we need to mov pindirs
.pio_version 1

.program fam_2114

.define CMD_ALL_OFF 0b11
.define CMD_CS_ON 0b10
.define CMD_ALL_ON 0b00

pull block             ; Wait for data pin dir mask.
out y, 32              ; Read the data pin dir mask into y.

; Timing slots:
;  [1] = tW delay 1
;  [2] = tW delay 2
;  [3] = WRITE cycle recovery 1
;  [4] = WRITE cycle recovery 2
;  [5] = tCO delay 1
;  [6] = tCO delay 2
;  [7] = READ cycle recovery 1
;  [8] = READ cycle recovery 2
;  [9] = READ cycle recovery 3
; [10] = READ cycle recovery 4

; Note we do not currently test tA read times. Only tCO.
; But for some chips - such as CMOS - that is the same time span!
begin:
    pull block             ; Get the next command. Let's start tRC/tWC loop here.
    out x, 1               ; Get first bit - which tells us if we are in write mode.
    out pins, 17           ; Load address, data, and CMD_ALL_OFF. Start of tDW.
    jmp !x read_branch     ; Skip write if not in write mode

write_branch:
    mov pindirs, ~NULL     ; All pins are outputs to ram.
    set pins, CMD_ALL_ON   ; Lower CS and WE. Start of tW.
    nop [1]                ; tW delay.
    nop [2]                ; tW delay.
    in NULL, 32            ; Need to let C code know we're finihed!
    push noblock           ; Send ISR to input FIFO.
    set pins, CMD_ALL_OFF  ; End of write pulse. tW, tDW must be met. Start of tDH.
    nop [3]                ; Write cycle recovery time.
    nop [4]                ; Write cycle recovery time.
    jmp begin              ; tDH, tWC must be met.

read_branch:
    mov pindirs, ~y        ; Data pins are inputs.
    set pins, CMD_CS_ON    ; Lower CS only. Start of tRC, tCO.
    nop[5]                 ; tCO delay.
    nop[6]                 ; tCO delay.
    in pins, 17            ; Sample pins into ISR. tCO mst be met.
    in NULL, 15            ; Shift pins right so they start at LSB of ISR.
    push noblock           ; Send ISR to input FIFO.
    set pins, CMD_ALL_OFF  ; Deselect the data. Start of tOTD.
    nop [7]                ; Read cycle recovery time 1.
    nop [8]                ; Read cycle recovery time 2.
    nop [9]                ; Read cycle recovery time 3.
    nop [10]                ; Read cycle recovery time 4.
    jmp begin              ; tOTD, tRC must be met.