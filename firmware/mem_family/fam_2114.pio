; 2114 Test Program

; Note: 'set PINDIRS' also sets all high order bits to 0, so we can't use it!

; Pin Assignments
; SP0  = IO4
; SP1  = IO3
; SP2  = A1
; SP3  = CS
; SP4  = WE
; SP5  = A0
; SP6  = A3
; SP7  = A4
; SP8  = A5
; SP9  = A7
; SP10 = A8
; SP11 = A9
; SP12 = A6
; SP13 = nc
; SP14 = IO1
; SP15 = A2
; SP16 = IO2

; PIO version 1 since we need to mov pindirs
.pio_version 1

.program fam_2114

.define CMD_ALL_OFF 0b11
.define CMD_CS_ON 0b10
.define CMD_ALL_ON 0b00

pull block             ; Wait for data pin dir mask.
out y, 32              ; Read the data pin dir mask into y.

; Timing slots:
;  [1] = tW delay 1
;  [2] = tW delay 2
;  [3] = tWC delay 1
;  [4] = tWC delay 2
;  [5] = tA - tCO delay 1
;  [6] = tA - tCO delay 2
;  [7] = tA - tCO delay 3
;  [8] = tCO delay 1
;  [9] = tCO delay 2
; [10] = tCO delay 3

; Note we do not currently test tA read times. Only tCO.
; But for some chips - such as CMOS - that is the same time span!
begin:
    pull block             ; Get the next command. Start tWC and tRC.
    out x, 1               ; Get write mode bit.
    out pins, 17           ; Load address, data, and CMD_ALL_OFF. Start of tRC, tA, tWC, tW. 
    jmp !x read_branch     ; Skip write if not in write mode

write_branch:
    mov pindirs, ~NULL     ; All pins act as outputs to ram.
    set pins, CMD_ALL_ON   ; Lower CS and WE. Start of tW.
    nop [1]                ; tW delay 1.
    nop [2]                ; tW delay 2.
    in NULL, 32            ; Need to let C code know we're finihed!
    push noblock           ; Send ISR to input FIFO.
    set pins, CMD_ALL_OFF  ; End of write pulse. tW, tDW must be met.
    nop [3]                ; Write cycle recovery time.
    nop [4]                ; Write cycle recovery time.
    jmp begin              ; tWC must be met.

read_branch:
    mov pindirs, ~y        ; Data pins act as inputs to the Pico.
    nop [5]                ; tA-tCO delay 1.
    nop [6]                ; tA-tCO delay 2.
    nop [7]                ; tA-tCO delay 3.
    set pins, CMD_CS_ON    ; Lower CS only. tA-tCO must be met. Start of tCO.
    nop [8]                ; tCO delay 1.
    nop [9]                ; tCO delay 2.
    nop [10]               ; tCO delay 3.
    in pins, 17            ; Sample the data into the ISR. tA and tCO must be met.
    in NULL, 15            ; Shift pins right so they start at LSB of ISR.
    push noblock           ; Send ISR to input FIFO.
    set pins, CMD_ALL_OFF  ; Deselect the data.
    jmp begin              ; tRC must be met.